@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation</PageTitle>

<main class="auth-page">
    <div class="auth-shell">
        <header class="auth-header">
            <a class="auth-brand" href="/" aria-label="Kwenta home">
                <span class="auth-brand-mark" aria-hidden="true">K</span>
                <span>Kwenta</span>
            </a>
            <h1>Check your inbox</h1>
            <p>Your password reset request has been received.</p>
        </header>

        <section class="auth-card auth-confirmation-card" aria-labelledby="reset-email-heading">
            <div class="auth-confirmation-icon" aria-hidden="true">✉</div>
            <h2 id="reset-email-heading">Reset link requested</h2>
            <p role="status">If an eligible Kwenta account exists for that email, we've sent it a secure password reset link.</p>
            <p class="auth-confirmation-note">The email may take a minute to arrive. Check your spam or promotions folder if you don't see it.</p>

            <div class="auth-confirmation-actions">
                <a class="auth-submit auth-action-link" href="Account/Login">Back to login</a>
                <a href="Account/ForgotPassword">Try another email</a>
            </div>
        </section>
    </div>
</main>
