@inherits LayoutComponentBase
@layout Kwenta.Components.Layout.MainLayout

<div class="manage-page">
    <header class="manage-header">
        <span class="manage-eyebrow">Your account</span>
        <h1>Account settings</h1>
        <p>Manage your profile, sign-in details, and account security.</p>
    </header>

    <div class="manage-layout">
        <aside class="manage-sidebar" aria-label="Account settings navigation">
            <ManageNavMenu />
        </aside>
        <main class="manage-content">
            @Body
        </main>
    </div>
</div>
