@inherits LayoutComponentBase

<div class="page">
    <input class="sidebar-toggle" type="checkbox" id="sidebar-toggle" aria-label="Toggle navigation sidebar" />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <label class="sidebar-toggle-button" for="sidebar-toggle" title="Toggle navigation">
                <span aria-hidden="true">☰</span>
                <span class="visually-hidden">Toggle navigation sidebar</span>
            </label>
            <span class="top-row-copy">Your money, made clear.</span>
        </div>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
