@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="dashboard">
            <span class="brand-mark" aria-hidden="true">K</span>
            <span>
                <strong>Kwenta</strong>
                <small>Personal finance</small>
            </span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                <p class="nav-section-label">Overview</p>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">
                        <span class="nav-icon" aria-hidden="true">⌂</span> Dashboard
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="chat">
                        <span class="nav-icon" aria-hidden="true">◌</span> Ask Kwenta
                    </NavLink>
                </div>

                <p class="nav-section-label">Money</p>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="accounts">
                        <span class="nav-icon" aria-hidden="true">▣</span> Accounts
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="transactions">
                        <span class="nav-icon" aria-hidden="true">⇄</span> Transactions
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="transfers">
                        <span class="nav-icon" aria-hidden="true">→</span> Transfers
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="expenses/add">
                        <span class="nav-icon" aria-hidden="true">−</span> Add Expense
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="income/add">
                        <span class="nav-icon" aria-hidden="true">＋</span> Add Income
                    </NavLink>
                </div>

                <p class="nav-section-label">Planning</p>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="budgets">
                        <span class="nav-icon" aria-hidden="true">◫</span> Budgets
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="savings-goals">
                        <span class="nav-icon" aria-hidden="true">◇</span> Savings Goals
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="allowance">
                        <span class="nav-icon" aria-hidden="true">₱</span> Weekly Allowance
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="categories">
                        <span class="nav-icon" aria-hidden="true">#</span> Categories
                    </NavLink>
                </div>

                <p class="nav-section-label">Help</p>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="faq">
                        <span class="nav-icon" aria-hidden="true">?</span> FAQ
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="nav-icon" aria-hidden="true">○</span>
                        <span class="user-name">@context.User.Identity?.Name</span>
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="nav-icon" aria-hidden="true">↪</span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="nav-icon" aria-hidden="true">＋</span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="nav-icon" aria-hidden="true">→</span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
