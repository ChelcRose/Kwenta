@page "/accounts"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-page">
<header class="page-header">
    <div>
        <h1>Accounts</h1>
        <p class="page-subtitle">Keep track of where your money lives and see every balance at a glance.</p>
    </div>
</header>

<EditForm Model="account" OnValidSubmit="SaveAccount" FormName="AddAccount" class="surface-card form-card">
    <h2 class="section-heading">Add an account</h2>
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-grid">
    <div class="form-field form-field-full">
        <label for="account-name">Name</label>
        <InputText id="account-name" @bind-Value="account.Name" />
        <ValidationMessage For="@(() => account.Name)" />
    </div>

    <div class="form-field">
        <label for="account-type">Account Type</label>
        <InputSelect id="account-type" @bind-Value="account.AccountType">
            <option value="">Select an account type</option>
            @foreach (var accountType in AccountTypes)
            {
                <option value="@accountType">@accountType</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => account.AccountType)" />
    </div>

    <div class="form-field">
        <label for="provider">Provider (optional)</label>
        <InputSelect id="provider" @bind-Value="account.ProviderSelection">
            <option value="">Not applicable</option>
            <option value="GCash">GCash</option>
            <option value="Maya">Maya</option>
            <option value="Custom">Custom</option>
        </InputSelect>
    </div>

    @if (account.ProviderSelection == "Custom")
    {
        <div class="form-field form-field-full">
            <label for="custom-provider">Custom Provider</label>
            <InputText id="custom-provider" @bind-Value="account.CustomProvider" />
            <ValidationMessage For="@(() => account.CustomProvider)" />
        </div>
    }

    <div class="form-field form-field-full">
        <label for="starting-balance">Starting Balance</label>
        <InputNumber id="starting-balance" @bind-Value="account.StartingBalance" step="0.01" />
        <ValidationMessage For="@(() => account.StartingBalance)" />
    </div>

    </div>

    <div class="form-actions">
        <button type="submit" class="app-button app-button-primary">Add Account</button>
    </div>
</EditForm>

<section class="content-section">
<div class="section-bar">
    <h2>Your accounts</h2>
</div>

@if (accounts.Count == 0)
{
    <div class="empty-state">No accounts yet. Add your first account above.</div>
}
else
{
    <div class="card-grid">
        @foreach (var item in accounts)
        {
            <article class="surface-card detail-card">
                <div class="detail-card-header">
                    <div>
                        <h3>@item.Account.Name</h3>
                        <p class="detail-meta">@(string.IsNullOrWhiteSpace(item.Account.Provider) ? item.Account.AccountType : $"{item.Account.Provider} · {item.Account.AccountType}")</p>
                    </div>
                    <span class="badge-soft badge-neutral">@item.Account.AccountType</span>
                </div>
                <p class="detail-amount money-value">@FormatPeso(item.CurrentBalance)</p>
                <span class="muted-text">Current balance</span>
            </article>
        }
    </div>
}
</section>
</div>

@code {
    private static readonly string[] AccountTypes =
    [
        "E-Wallet",
        "Digital Bank",
        "Savings",
        "Checking",
        "Cash",
        "Credit Card",
        "Other"
    ];

    [SupplyParameterFromForm(FormName = "AddAccount")]
    private AccountInput account { get; set; } = default!;
    private List<AccountBalance> accounts = [];

    protected override async Task OnInitializedAsync()
    {
        account ??= new AccountInput();
        await LoadAccounts();
    }

    private async Task LoadAccounts()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId is null)
            return;

        var userAccounts = await Db.FinancialAccounts
            .Where(a => a.UserId == userId && !a.IsArchived)
            .ToListAsync();

        var accountIds = userAccounts.Select(a => a.Id).ToList();

        var transactions = await Db.Transactions
            .Where(transaction =>
                transaction.UserId == userId &&
                accountIds.Contains(transaction.AccountId))
            .Select(transaction => new
            {
                transaction.AccountId,
                transaction.Type,
                transaction.Amount
            })
            .ToListAsync();

        var transfers = await Db.Transfers.AsNoTracking()
            .Where(transfer => transfer.UserId == userId &&
                transfer.FromAccount.UserId == userId && transfer.ToAccount.UserId == userId &&
                (accountIds.Contains(transfer.FromAccountId) || accountIds.Contains(transfer.ToAccountId)))
            .Select(transfer => new { transfer.FromAccountId, transfer.ToAccountId, transfer.Amount })
            .ToListAsync();
        var reimbursements = await Db.Reimbursements.AsNoTracking()
            .Where(item => item.UserId == userId && item.ReceivingAccount.UserId == userId &&
                accountIds.Contains(item.ReceivingAccountId))
            .Select(item => new { item.ReceivingAccountId, item.Amount })
            .ToListAsync();

        accounts = userAccounts
            .Select(userAccount => new AccountBalance
            {
                Account = userAccount,
                CurrentBalance = FinancialCalculations.AccountBalance(
                    userAccount.StartingBalance,
                    transactions
                        .Where(transaction =>
                            transaction.AccountId == userAccount.Id &&
                            transaction.Type == TransactionType.Income)
                        .Sum(transaction => transaction.Amount),
                    transactions
                        .Where(transaction =>
                            transaction.AccountId == userAccount.Id &&
                            transaction.Type == TransactionType.Expense)
                        .Sum(transaction => transaction.Amount),
                    transfers.Where(transfer => transfer.ToAccountId == userAccount.Id)
                        .Sum(transfer => transfer.Amount),
                    transfers.Where(transfer => transfer.FromAccountId == userAccount.Id)
                        .Sum(transfer => transfer.Amount),
                    reimbursements.Where(item => item.ReceivingAccountId == userAccount.Id)
                        .Sum(item => item.Amount))
            })
            .ToList();
    }

    private async Task SaveAccount()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId is null)
            return;

        var financialAccount = new FinancialAccount
        {
            UserId = userId,
            Name = account.Name.Trim(),
            AccountType = account.AccountType,
            Provider = account.ProviderSelection switch
            {
                "GCash" or "Maya" => account.ProviderSelection,
                "Custom" => account.CustomProvider?.Trim(),
                _ => null
            },
            StartingBalance = account.StartingBalance!.Value
        };

        Db.FinancialAccounts.Add(financialAccount);
        await Db.SaveChangesAsync();

        account = new AccountInput();

        await LoadAccounts();
    }

    private static string FormatPeso(decimal amount) =>
        $"₱{amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"))}";

    private sealed class AccountBalance
    {
        public required FinancialAccount Account { get; init; }

        public decimal CurrentBalance { get; init; }
    }

    private sealed class AccountInput : IValidatableObject
    {
        [Required(ErrorMessage = "Account name is required.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Account type is required.")]
        public string AccountType { get; set; } = string.Empty;

        public string ProviderSelection { get; set; } = string.Empty;

        public string? CustomProvider { get; set; }

        [Required(ErrorMessage = "Starting balance is required.")]
        [Range(typeof(decimal), "-999999999999.99", "999999999999.99",
            ErrorMessage = "Enter a valid PHP amount.")]
        public decimal? StartingBalance { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrEmpty(Name) && string.IsNullOrWhiteSpace(Name))
            {
                yield return new ValidationResult(
                    "Account name is required.",
                    [nameof(Name)]);
            }

            if (!string.IsNullOrWhiteSpace(AccountType) && !AccountTypes.Contains(AccountType))
            {
                yield return new ValidationResult(
                    "Select a valid account type.",
                    [nameof(AccountType)]);
            }

            if (ProviderSelection is not ("" or "GCash" or "Maya" or "Custom"))
            {
                yield return new ValidationResult(
                    "Select a valid provider.",
                    [nameof(ProviderSelection)]);
            }

            if (ProviderSelection == "Custom" && string.IsNullOrWhiteSpace(CustomProvider))
            {
                yield return new ValidationResult(
                    "Enter a custom provider.",
                    [nameof(CustomProvider)]);
            }

            if (StartingBalance is decimal balance && decimal.Round(balance, 2) != balance)
            {
                yield return new ValidationResult(
                    "Starting balance can have at most two decimal places.",
                    [nameof(StartingBalance)]);
            }
        }
    }
}
