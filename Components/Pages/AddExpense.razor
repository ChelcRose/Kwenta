@page "/expenses/add"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-page">
<header class="page-header">
    <div>
        <h1>Add Expense</h1>
        <p class="page-subtitle">Record spending against one of your financial accounts.</p>
    </div>
</header>

@if (accounts.Count == 0)
{
    <div class="status-message status-error">Create an active financial account before adding an expense.</div>
}

<EditForm Model="expense" OnValidSubmit="SaveExpense" FormName="AddExpense" class="surface-card form-card">
    <h2 class="section-heading">Expense details</h2>
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <p class="status-message status-error" role="alert">@saveError</p>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="status-message status-success" role="status">@successMessage</p>
    }

    <div class="form-grid">
    <div class="form-field">
        <label for="expense-amount">Amount</label>
        <InputNumber id="expense-amount" @bind-Value="expense.Amount" step="0.01" />
        <ValidationMessage For="@(() => expense.Amount)" />
    </div>

    <div class="form-field">
        <label for="expense-account">Financial Account</label>
        <InputSelect id="expense-account" @bind-Value="expense.AccountId">
            <option value="">Select an account</option>
            @foreach (var account in accounts)
            {
                <option value="@account.Id">@account.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => expense.AccountId)" />
    </div>

    <div class="form-field">
        <label for="expense-category">Expense Category</label>
        <InputSelect id="expense-category" @bind-Value="expense.CategoryId">
            <option value="">Select a category</option>
            @foreach (var category in expenseCategories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => expense.CategoryId)" />
    </div>

    <div class="form-field">
        <label for="expense-date">Date</label>
        <InputDate id="expense-date" @bind-Value="expense.Date" />
        <ValidationMessage For="@(() => expense.Date)" />
    </div>

    <div class="form-field form-field-full">
        <label for="expense-merchant">Merchant/Payee</label>
        <InputText id="expense-merchant" @bind-Value="expense.Merchant" />
        <ValidationMessage For="@(() => expense.Merchant)" />
    </div>

    <div class="form-field form-field-full">
        <label for="expense-description">Description (optional)</label>
        <InputTextArea id="expense-description" @bind-Value="expense.Description" />
    </div>

    @if (activeAllowance is not null)
    {
        <div class="form-field form-field-full">
            <label class="allowance-checkbox-label">
                <InputCheckbox class="allowance-checkbox" @bind-Value="expense.CountAgainstAllowance" />
                <span>Count this against this week's allowance</span>
            </label>
            <span class="muted-text">@activeAllowance.StartDate.ToString("MMM d") – @activeAllowance.EndDate.ToString("MMM d")</span>
        </div>
    }

    </div>
    <div class="form-actions">
        <button type="submit" class="app-button app-button-primary" disabled="@(accounts.Count == 0)">Add Expense</button>
    </div>
</EditForm>

<section class="content-section">
<div class="section-bar"><h2>Recent expenses</h2></div>

@if (recentExpenses.Count == 0)
{
    <div class="empty-state">No expenses yet.</div>
}
else
{
    <div class="surface-card data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Amount</th>
                <th>Category</th>
                <th>Account</th>
                <th>Date</th>
                <th>Merchant/Payee</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in recentExpenses)
            {
                <tr>
                    <td data-label="Amount" class="money-value money-negative">@FormatPeso(transaction.Amount)</td>
                    <td data-label="Category">@transaction.Category.Name</td>
                    <td data-label="Account">@transaction.FinancialAccount.Name</td>
                    <td data-label="Date">@transaction.Date.ToString("MMM d, yyyy", CultureInfo.GetCultureInfo("en-PH"))</td>
                    <td data-label="Merchant/Payee">@transaction.Merchant</td>
                    <td data-label="Description" class="muted-text">@(string.IsNullOrWhiteSpace(transaction.Description) ? "—" : transaction.Description)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
</section>
</div>

@code {
    private ExpenseInput expense = NewExpense();
    private List<FinancialAccount> accounts = [];
    private List<Category> expenseCategories = [];
    private List<Transaction> recentExpenses = [];
    private WeeklyAllowance? activeAllowance;
    private string? saveError;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var userId = await GetCurrentUserId();

        if (userId is null)
            return;

        accounts = await Db.FinancialAccounts
            .Where(account => account.UserId == userId && !account.IsArchived)
            .OrderBy(account => account.Name)
            .ToListAsync();

        expenseCategories = await Db.Categories
            .Where(category =>
                category.Type == CategoryType.Expense &&
                ((category.IsDefault && category.UserId == null) ||
                 (!category.IsDefault && category.UserId == userId)))
            .OrderBy(category => category.Name)
            .ToListAsync();

        activeAllowance = await Db.WeeklyAllowances.AsNoTracking()
            .SingleOrDefaultAsync(allowance => allowance.UserId == userId && allowance.IsActive);
        expense.CountAgainstAllowance = activeAllowance is not null;

        await LoadRecentExpenses(userId);
    }

    private async Task SaveExpense()
    {
        saveError = null;
        successMessage = null;

        var userId = await GetCurrentUserId();

        if (userId is null)
        {
            saveError = "You must be logged in to add an expense.";
            return;
        }

        var accountExists = await Db.FinancialAccounts.AnyAsync(account =>
            account.Id == expense.AccountId &&
            account.UserId == userId &&
            !account.IsArchived);

        if (!accountExists)
        {
            saveError = "Select one of your active financial accounts.";
            return;
        }

        var categoryExists = await Db.Categories.AnyAsync(category =>
            category.Id == expense.CategoryId &&
            category.Type == CategoryType.Expense &&
            ((category.IsDefault && category.UserId == null) ||
             (!category.IsDefault && category.UserId == userId)));

        if (!categoryExists)
        {
            saveError = "Select a valid expense category.";
            return;
        }

        WeeklyAllowance? allowance = null;
        if (expense.CountAgainstAllowance)
        {
            allowance = await Db.WeeklyAllowances.AsNoTracking().SingleOrDefaultAsync(item =>
                item.UserId == userId && item.IsActive &&
                expense.Date >= item.StartDate && expense.Date <= item.EndDate);
            if (allowance is null)
            {
                saveError = "The expense date must fall within your active weekly allowance period.";
                return;
            }
        }

        var transaction = new Transaction
        {
            UserId = userId,
            AccountId = expense.AccountId!.Value,
            CategoryId = expense.CategoryId!.Value,
            Type = TransactionType.Expense,
            Amount = expense.Amount!.Value,
            Date = expense.Date!.Value,
            Merchant = expense.Merchant.Trim(),
            Description = string.IsNullOrWhiteSpace(expense.Description)
                ? null
                : expense.Description.Trim(),
            WeeklyAllowanceId = allowance?.Id
        };

        Db.Transactions.Add(transaction);
        await Db.SaveChangesAsync();

        expense = NewExpense();
        expense.CountAgainstAllowance = activeAllowance is not null;
        successMessage = "Expense added.";

        await LoadRecentExpenses(userId);
    }

    private async Task LoadRecentExpenses(string userId)
    {
        recentExpenses = await Db.Transactions
            .AsNoTracking()
            .Include(transaction => transaction.Category)
            .Include(transaction => transaction.FinancialAccount)
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                transaction.Type == TransactionType.Expense)
            .OrderByDescending(transaction => transaction.Date)
            .ThenByDescending(transaction => transaction.Id)
            .Take(10)
            .ToListAsync();
    }

    private async Task<string?> GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private static ExpenseInput NewExpense() => new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today)
    };

    private static string FormatPeso(decimal amount) =>
        $"₱{amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"))}";

    private sealed class ExpenseInput : IValidatableObject
    {
        [Required(ErrorMessage = "Amount is required.")]
        [Range(typeof(decimal), "0.01", "999999999999.99",
            ErrorMessage = "Amount must be greater than zero.")]
        public decimal? Amount { get; set; }

        [Required(ErrorMessage = "Financial account is required.")]
        public int? AccountId { get; set; }

        [Required(ErrorMessage = "Expense category is required.")]
        public int? CategoryId { get; set; }

        [Required(ErrorMessage = "Date is required.")]
        public DateOnly? Date { get; set; }

        [Required(ErrorMessage = "Merchant/payee is required.")]
        public string Merchant { get; set; } = string.Empty;

        public string? Description { get; set; }

        public bool CountAgainstAllowance { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrEmpty(Merchant) && string.IsNullOrWhiteSpace(Merchant))
            {
                yield return new ValidationResult(
                    "Merchant/payee is required.",
                    [nameof(Merchant)]);
            }

            if (Amount is decimal amount && decimal.Round(amount, 2) != amount)
            {
                yield return new ValidationResult(
                    "Amount can have at most two decimal places.",
                    [nameof(Amount)]);
            }
        }
    }
}
