@page "/income/add"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-page">
<header class="page-header">
    <div>
        <h1>Add Income</h1>
        <p class="page-subtitle">Record money received into one of your financial accounts.</p>
    </div>
</header>

@if (accounts.Count == 0)
{
    <div class="status-message status-error">Create an active financial account before adding income.</div>
}

<EditForm Model="income" OnValidSubmit="SaveIncome" FormName="AddIncome" class="surface-card form-card">
    <h2 class="section-heading">Income details</h2>
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <p class="status-message status-error" role="alert">@saveError</p>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="status-message status-success" role="status">@successMessage</p>
    }

    <div class="form-grid">
    <div class="form-field">
        <label for="income-amount">Amount</label>
        <InputNumber id="income-amount" @bind-Value="income.Amount" step="0.01" />
        <ValidationMessage For="@(() => income.Amount)" />
    </div>

    <div class="form-field">
        <label for="income-account">Receiving Financial Account</label>
        <InputSelect id="income-account" @bind-Value="income.AccountId">
            <option value="">Select an account</option>
            @foreach (var account in accounts)
            {
                <option value="@account.Id">@account.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => income.AccountId)" />
    </div>

    <div class="form-field">
        <label for="income-category">Income Category</label>
        <InputSelect id="income-category" @bind-Value="income.CategoryId">
            <option value="">Select a category</option>
            @foreach (var category in incomeCategories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => income.CategoryId)" />
    </div>

    <div class="form-field">
        <label for="income-source">Source</label>
        <InputText id="income-source" @bind-Value="income.Source" />
        <ValidationMessage For="@(() => income.Source)" />
    </div>

    <div class="form-field form-field-full">
        <label for="income-date">Date</label>
        <InputDate id="income-date" @bind-Value="income.Date" />
        <ValidationMessage For="@(() => income.Date)" />
    </div>

    <div class="form-field form-field-full">
        <label for="income-description">Description (optional)</label>
        <InputTextArea id="income-description" @bind-Value="income.Description" />
    </div>

    </div>
    <div class="form-actions">
        <button type="submit" class="app-button app-button-primary" disabled="@(accounts.Count == 0)">Add Income</button>
    </div>
</EditForm>

<section class="content-section">
<div class="section-bar"><h2>Recent income</h2></div>

@if (recentIncome.Count == 0)
{
    <div class="empty-state">No income yet.</div>
}
else
{
    <div class="surface-card data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Amount</th>
                <th>Category</th>
                <th>Account</th>
                <th>Date</th>
                <th>Source</th>
                <th>Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in recentIncome)
            {
                <tr>
                    <td data-label="Amount" class="money-value money-positive">@FormatPeso(transaction.Amount)</td>
                    <td data-label="Category">@transaction.Category.Name</td>
                    <td data-label="Account">@transaction.FinancialAccount.Name</td>
                    <td data-label="Date">@transaction.Date.ToString("MMM d, yyyy", CultureInfo.GetCultureInfo("en-PH"))</td>
                    <td data-label="Source">@transaction.Merchant</td>
                    <td data-label="Description" class="muted-text">@(string.IsNullOrWhiteSpace(transaction.Description) ? "—" : transaction.Description)</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
</section>
</div>

@code {
    private IncomeInput income = NewIncome();
    private List<FinancialAccount> accounts = [];
    private List<Category> incomeCategories = [];
    private List<Transaction> recentIncome = [];
    private string? saveError;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        var userId = await GetCurrentUserId();

        if (userId is null)
            return;

        accounts = await Db.FinancialAccounts
            .Where(account => account.UserId == userId && !account.IsArchived)
            .OrderBy(account => account.Name)
            .ToListAsync();

        incomeCategories = await Db.Categories
            .Where(category =>
                category.Type == CategoryType.Income &&
                ((category.IsDefault && category.UserId == null) ||
                 (!category.IsDefault && category.UserId == userId)))
            .OrderBy(category => category.Name)
            .ToListAsync();

        await LoadRecentIncome(userId);
    }

    private async Task SaveIncome()
    {
        saveError = null;
        successMessage = null;

        var userId = await GetCurrentUserId();

        if (userId is null)
        {
            saveError = "You must be logged in to add income.";
            return;
        }

        var accountExists = await Db.FinancialAccounts.AnyAsync(account =>
            account.Id == income.AccountId &&
            account.UserId == userId &&
            !account.IsArchived);

        if (!accountExists)
        {
            saveError = "Select one of your active financial accounts.";
            return;
        }

        var categoryExists = await Db.Categories.AnyAsync(category =>
            category.Id == income.CategoryId &&
            category.Type == CategoryType.Income &&
            ((category.IsDefault && category.UserId == null) ||
             (!category.IsDefault && category.UserId == userId)));

        if (!categoryExists)
        {
            saveError = "Select a valid income category.";
            return;
        }

        var transaction = new Transaction
        {
            UserId = userId,
            AccountId = income.AccountId!.Value,
            CategoryId = income.CategoryId!.Value,
            Type = TransactionType.Income,
            Amount = income.Amount!.Value,
            Date = income.Date!.Value,
            Merchant = income.Source.Trim(),
            Description = string.IsNullOrWhiteSpace(income.Description)
                ? null
                : income.Description.Trim()
        };

        Db.Transactions.Add(transaction);
        await Db.SaveChangesAsync();

        income = NewIncome();
        successMessage = "Income added.";

        await LoadRecentIncome(userId);
    }

    private async Task LoadRecentIncome(string userId)
    {
        recentIncome = await Db.Transactions
            .AsNoTracking()
            .Include(transaction => transaction.Category)
            .Include(transaction => transaction.FinancialAccount)
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                transaction.Type == TransactionType.Income)
            .OrderByDescending(transaction => transaction.Date)
            .ThenByDescending(transaction => transaction.Id)
            .Take(10)
            .ToListAsync();
    }

    private async Task<string?> GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private static IncomeInput NewIncome() => new()
    {
        Date = DateOnly.FromDateTime(DateTime.Today)
    };

    private static string FormatPeso(decimal amount) =>
        $"₱{amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"))}";

    private sealed class IncomeInput : IValidatableObject
    {
        [Required(ErrorMessage = "Amount is required.")]
        [Range(typeof(decimal), "0.01", "999999999999.99",
            ErrorMessage = "Amount must be greater than zero.")]
        public decimal? Amount { get; set; }

        [Required(ErrorMessage = "Receiving financial account is required.")]
        public int? AccountId { get; set; }

        [Required(ErrorMessage = "Income category is required.")]
        public int? CategoryId { get; set; }

        [Required(ErrorMessage = "Source is required.")]
        public string Source { get; set; } = string.Empty;

        [Required(ErrorMessage = "Date is required.")]
        public DateOnly? Date { get; set; }

        public string? Description { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrEmpty(Source) && string.IsNullOrWhiteSpace(Source))
            {
                yield return new ValidationResult(
                    "Source is required.",
                    [nameof(Source)]);
            }

            if (Amount is decimal amount && decimal.Round(amount, 2) != amount)
            {
                yield return new ValidationResult(
                    "Amount can have at most two decimal places.",
                    [nameof(Amount)]);
            }
        }
    }
}
