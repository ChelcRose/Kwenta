@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>

<div class="app-page">
<header class="page-header">
    <div>
        <h1>Financial overview</h1>
        <p class="page-subtitle">Your balances, monthly activity, budgets, and goals in one place.</p>
    </div>
    <span class="badge-soft badge-neutral">@currentMonthName</span>
</header>

<section class="metric-grid" aria-label="Financial summary">
    <article class="surface-card metric-card metric-card-primary">
        <span class="metric-label">Total balance</span>
        <strong class="metric-value">@FormatPeso(totalBalance)</strong>
    </article>
    <article class="surface-card metric-card">
        <span class="metric-label">Income this month</span>
        <strong class="metric-value money-positive">@FormatPeso(currentMonthIncome)</strong>
    </article>
    <article class="surface-card metric-card">
        <span class="metric-label">Expenses this month</span>
        <strong class="metric-value money-negative">@FormatPeso(currentMonthExpenses)</strong>
    </article>
    <article class="surface-card metric-card">
        <span class="metric-label">Saved this month</span>
        <strong class="metric-value @(amountSavedThisMonth < 0 ? "money-negative" : "money-positive")">@FormatPeso(amountSavedThisMonth)</strong>
    </article>
    <article class="surface-card metric-card">
        <span class="metric-label">Remaining budget</span>
        <strong class="metric-value @(totalRemainingBudget < 0 ? "money-negative" : "")">@FormatPeso(totalRemainingBudget)</strong>
    </article>
</section>

<div class="dashboard-grid">
    <div class="dashboard-stack">
        <section class="surface-card section-card">
            <div class="section-bar">
                <h2>Recent transactions</h2>
                <a class="text-action" href="/transactions">View all</a>
            </div>
            @if (recentTransactions.Count == 0)
            {
                <div class="empty-state">No transactions yet.</div>
            }
            else
            {
                <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Amount</th><th>Type</th><th>Details</th><th>Account</th><th>Date</th></tr></thead>
                    <tbody>
                    @foreach (var transaction in recentTransactions)
                    {
                        <tr>
                            <td data-label="Amount" class="money-value @(transaction.Type == TransactionType.Income ? "money-positive" : "money-negative")">@FormatPeso(transaction.Amount)</td>
                            <td data-label="Type"><span class="badge-soft @(transaction.Type == TransactionType.Income ? "badge-income" : "badge-expense")">@transaction.Type</span></td>
                            <td data-label="Details"><strong>@transaction.Category.Name</strong><div class="detail-meta">@transaction.Merchant</div></td>
                            <td data-label="Account">@transaction.FinancialAccount.Name</td>
                            <td data-label="Date">@transaction.Date.ToString("MMM d, yyyy", PhilippineCulture)</td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>

        <section class="surface-card section-card">
            <div class="section-bar"><h2>Budget progress</h2><span class="muted-text">@currentMonthName</span></div>
            @if (budgetProgress.Count == 0)
            {
                <div class="empty-state">No budgets for this month.</div>
            }
            else
            {
                <div class="data-table-wrap">
                <table class="data-table">
                    <thead><tr><th>Category</th><th>Limit</th><th>Spent</th><th>Remaining</th><th>Used</th></tr></thead>
                    <tbody>
                    @foreach (var progress in budgetProgress)
                    {
                        <tr>
                            <td data-label="Category"><strong>@progress.Budget.Category.Name</strong><div class="detail-meta"><span class="badge-soft @(progress.IsOverBudget ? "badge-danger" : "badge-success")">@(progress.IsOverBudget ? "Over budget" : "Within budget")</span></div></td>
                            <td data-label="Limit" class="money-value">@FormatPeso(progress.Budget.LimitAmount)</td>
                            <td data-label="Spent" class="money-value">@FormatPeso(progress.AmountSpent)</td>
                            <td data-label="Remaining" class="money-value @(progress.Remaining < 0 ? "money-negative" : "")">@FormatPeso(progress.Remaining)</td>
                            <td data-label="Used">
                                <div class="progress-copy"><strong>@FormatPercentage(progress.PercentageUsed)</strong></div>
                                <div class="progress-track" aria-hidden="true"><div class="progress-fill @(progress.IsOverBudget ? "progress-fill-over" : "")" style="width: @Math.Clamp(progress.PercentageUsed, 0, 100)%"></div></div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </section>
    </div>

    <aside class="dashboard-stack">
        <section class="surface-card section-card">
            <div class="section-bar"><h2>Account balances</h2><a class="text-action" href="/accounts">Manage</a></div>
            @if (accountBalances.Count == 0)
            {
                <div class="empty-state">No active accounts yet.</div>
            }
            else
            {
                <div class="dashboard-list">
                @foreach (var account in accountBalances)
                {
                    <div class="dashboard-list-item">
                        <div><strong>@account.Account.Name</strong><div class="detail-meta">@(string.IsNullOrWhiteSpace(account.Account.Provider) ? account.Account.AccountType : account.Account.Provider)</div></div>
                        <strong class="money-value">@FormatPeso(account.CurrentBalance)</strong>
                    </div>
                }
                </div>
            }
        </section>

        <section class="surface-card section-card">
            <div class="section-bar"><h2>Savings goals</h2><a class="text-action" href="/savings-goals">View all</a></div>
            @if (savingsGoalProgress.Count == 0)
            {
                <div class="empty-state">No savings goals yet.</div>
            }
            else
            {
                <div class="goal-list">
                @foreach (var progress in savingsGoalProgress)
                {
                    <article class="goal-list-item">
                        <div class="detail-card-header"><strong>@progress.Goal.Name</strong><span class="badge-soft badge-neutral">@FormatPercentage(progress.PercentageProgress)</span></div>
                        <div class="progress-copy"><span>@FormatPeso(progress.Goal.CurrentSavedAmount) saved</span><span>@FormatPeso(progress.Remaining) left</span></div>
                        <div class="progress-track" aria-hidden="true"><div class="progress-fill" style="width: @Math.Clamp(progress.PercentageProgress, 0, 100)%"></div></div>
                    </article>
                }
                </div>
            }
        </section>
    </aside>
</div>
</div>

@code {
    private static readonly CultureInfo PhilippineCulture = CultureInfo.GetCultureInfo("en-PH");

    private List<AccountBalance> accountBalances = [];
    private List<Transaction> recentTransactions = [];
    private List<BudgetProgress> budgetProgress = [];
    private List<SavingsGoalProgress> savingsGoalProgress = [];
    private decimal totalBalance;
    private decimal currentMonthIncome;
    private decimal currentMonthExpenses;
    private decimal amountSavedThisMonth;
    private decimal totalRemainingBudget;
    private string currentMonthName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var userId = await GetCurrentUserId();

        if (userId is null)
            return;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var monthStart = new DateOnly(today.Year, today.Month, 1);
        var nextMonthStart = monthStart.AddMonths(1);
        currentMonthName = monthStart.ToString("MMMM yyyy", PhilippineCulture);

        await LoadAccountBalances(userId);
        await LoadMonthlyTransactions(userId, monthStart, nextMonthStart);
        await LoadRecentTransactions(userId);
        await LoadBudgetProgress(userId, today, monthStart, nextMonthStart);
        await LoadSavingsGoals(userId);
    }

    private async Task LoadAccountBalances(string userId)
    {
        var accounts = await Db.FinancialAccounts
            .AsNoTracking()
            .Where(account => account.UserId == userId && !account.IsArchived)
            .OrderBy(account => account.Name)
            .ToListAsync();

        var accountIds = accounts.Select(account => account.Id).ToList();
        var transactions = await Db.Transactions
            .AsNoTracking()
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                accountIds.Contains(transaction.AccountId))
            .Select(transaction => new
            {
                transaction.AccountId,
                transaction.Type,
                transaction.Amount
            })
            .ToListAsync();

        var transfers = await Db.Transfers.AsNoTracking()
            .Where(transfer => transfer.UserId == userId &&
                transfer.FromAccount.UserId == userId && transfer.ToAccount.UserId == userId &&
                (accountIds.Contains(transfer.FromAccountId) || accountIds.Contains(transfer.ToAccountId)))
            .Select(transfer => new { transfer.FromAccountId, transfer.ToAccountId, transfer.Amount })
            .ToListAsync();

        accountBalances = accounts
            .Select(account =>
            {
                var income = transactions
                    .Where(transaction =>
                        transaction.AccountId == account.Id &&
                        transaction.Type == TransactionType.Income)
                    .Sum(transaction => transaction.Amount);
                var expenses = transactions
                    .Where(transaction =>
                        transaction.AccountId == account.Id &&
                        transaction.Type == TransactionType.Expense)
                    .Sum(transaction => transaction.Amount);

                return new AccountBalance(
                    account,
                    FinancialCalculations.AccountBalance(
                        account.StartingBalance,
                        income,
                        expenses,
                        transfers.Where(transfer => transfer.ToAccountId == account.Id).Sum(transfer => transfer.Amount),
                        transfers.Where(transfer => transfer.FromAccountId == account.Id).Sum(transfer => transfer.Amount)));
            })
            .ToList();

        totalBalance = accountBalances.Sum(account => account.CurrentBalance);
    }

    private async Task LoadMonthlyTransactions(
        string userId,
        DateOnly monthStart,
        DateOnly nextMonthStart)
    {
        var monthlyTransactions = await Db.Transactions
            .AsNoTracking()
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                transaction.Date >= monthStart &&
                transaction.Date < nextMonthStart &&
                (transaction.Type == TransactionType.Income ||
                 transaction.Type == TransactionType.Expense))
            .Select(transaction => new
            {
                transaction.Type,
                transaction.Amount
            })
            .ToListAsync();

        currentMonthIncome = monthlyTransactions
            .Where(transaction => transaction.Type == TransactionType.Income)
            .Sum(transaction => transaction.Amount);
        currentMonthExpenses = monthlyTransactions
            .Where(transaction => transaction.Type == TransactionType.Expense)
            .Sum(transaction => transaction.Amount);
        amountSavedThisMonth = FinancialCalculations.AmountSaved(
            currentMonthIncome,
            currentMonthExpenses);
    }

    private async Task LoadRecentTransactions(string userId)
    {
        recentTransactions = await Db.Transactions
            .AsNoTracking()
            .Include(transaction => transaction.Category)
            .Include(transaction => transaction.FinancialAccount)
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                (transaction.Type == TransactionType.Income ||
                 transaction.Type == TransactionType.Expense))
            .OrderByDescending(transaction => transaction.Date)
            .ThenByDescending(transaction => transaction.Id)
            .Take(5)
            .ToListAsync();
    }

    private async Task LoadBudgetProgress(
        string userId,
        DateOnly today,
        DateOnly monthStart,
        DateOnly nextMonthStart)
    {
        var budgets = await Db.Budgets
            .AsNoTracking()
            .Include(budget => budget.Category)
            .Where(budget =>
                budget.UserId == userId &&
                budget.Month == today.Month &&
                budget.Year == today.Year)
            .OrderBy(budget => budget.Category.Name)
            .ToListAsync();

        if (budgets.Count == 0)
        {
            budgetProgress = [];
            totalRemainingBudget = 0;
            return;
        }

        var categoryIds = budgets
            .Select(budget => budget.CategoryId)
            .ToList();
        var expenses = await Db.Transactions
            .AsNoTracking()
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                transaction.Type == TransactionType.Expense &&
                categoryIds.Contains(transaction.CategoryId) &&
                transaction.Date >= monthStart &&
                transaction.Date < nextMonthStart)
            .Select(transaction => new
            {
                transaction.CategoryId,
                transaction.Amount
            })
            .ToListAsync();

        var spendingByCategory = expenses
            .GroupBy(transaction => transaction.CategoryId)
            .ToDictionary(
                group => group.Key,
                group => group.Sum(transaction => transaction.Amount));

        budgetProgress = budgets
            .Select(budget =>
            {
                spendingByCategory.TryGetValue(budget.CategoryId, out var amountSpent);
                return new BudgetProgress(budget, amountSpent);
            })
            .ToList();

        totalRemainingBudget = budgetProgress.Sum(progress => progress.Remaining);
    }

    private async Task LoadSavingsGoals(string userId)
    {
        var goals = await Db.SavingsGoals
            .AsNoTracking()
            .Where(goal => goal.UserId == userId)
            .OrderByDescending(goal => goal.Id)
            .ToListAsync();

        savingsGoalProgress = goals
            .Select(goal => new SavingsGoalProgress(goal))
            .ToList();
    }

    private async Task<string?> GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private static string FormatPeso(decimal amount)
    {
        var formattedAmount = decimal.Abs(amount).ToString("N2", PhilippineCulture);

        return amount < 0
            ? $"-₱{formattedAmount}"
            : $"₱{formattedAmount}";
    }

    private static string FormatPercentage(decimal percentage) =>
        $"{percentage.ToString("0.##", PhilippineCulture)}%";

    private sealed record AccountBalance(
        FinancialAccount Account,
        decimal CurrentBalance);

    private sealed record BudgetProgress(Budget Budget, decimal AmountSpent)
    {
        public decimal Remaining =>
            FinancialCalculations.BudgetRemaining(Budget.LimitAmount, AmountSpent);

        public decimal PercentageUsed =>
            FinancialCalculations.BudgetPercentageUsed(Budget.LimitAmount, AmountSpent);

        public bool IsOverBudget =>
            FinancialCalculations.IsOverBudget(Budget.LimitAmount, AmountSpent);
    }

    private sealed record SavingsGoalProgress(SavingsGoal Goal)
    {
        public decimal Remaining =>
            FinancialCalculations.SavingsGoalRemaining(
                Goal.TargetAmount,
                Goal.CurrentSavedAmount);

        public decimal PercentageProgress =>
            FinancialCalculations.SavingsGoalPercentage(
                Goal.TargetAmount,
                Goal.CurrentSavedAmount);
    }
}
