@page "/dashboard"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<section>
    <h2>Overview</h2>
    <p>Total Balance: @FormatPeso(totalBalance)</p>
    <p>Income This Month: @FormatPeso(currentMonthIncome)</p>
    <p>Expenses This Month: @FormatPeso(currentMonthExpenses)</p>
    <p>Saved This Month: @FormatPeso(amountSavedThisMonth)</p>
    <p>Remaining Budget: @FormatPeso(totalRemainingBudget)</p>
</section>

<section>
    <h2>Account Balances</h2>

    @if (accountBalances.Count == 0)
    {
        <p>No active accounts yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Provider</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var account in accountBalances)
                {
                    <tr>
                        <td>@account.Account.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(account.Account.Provider) ? "—" : account.Account.Provider)</td>
                        <td>@FormatPeso(account.CurrentBalance)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Recent Transactions</h2>

    @if (recentTransactions.Count == 0)
    {
        <p>No transactions yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Amount</th>
                    <th>Type</th>
                    <th>Category</th>
                    <th>Account</th>
                    <th>Date</th>
                    <th>Merchant/Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in recentTransactions)
                {
                    <tr>
                        <td>@FormatPeso(transaction.Amount)</td>
                        <td>@transaction.Type</td>
                        <td>@transaction.Category.Name</td>
                        <td>@transaction.FinancialAccount.Name</td>
                        <td>@transaction.Date.ToString("MMM d, yyyy", PhilippineCulture)</td>
                        <td>@transaction.Merchant</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Budget Progress — @currentMonthName</h2>

    @if (budgetProgress.Count == 0)
    {
        <p>No budgets for this month.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Category</th>
                    <th>Limit</th>
                    <th>Spent</th>
                    <th>Remaining</th>
                    <th>Used</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var progress in budgetProgress)
                {
                    <tr>
                        <td>@progress.Budget.Category.Name</td>
                        <td>@FormatPeso(progress.Budget.LimitAmount)</td>
                        <td>@FormatPeso(progress.AmountSpent)</td>
                        <td>@FormatPeso(progress.Remaining)</td>
                        <td>@FormatPercentage(progress.PercentageUsed)</td>
                        <td>@(progress.IsOverBudget ? "Over budget" : "Within budget")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section>
    <h2>Active Savings Goals</h2>

    @if (savingsGoalProgress.Count == 0)
    {
        <p>No savings goals yet.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Target</th>
                    <th>Saved</th>
                    <th>Remaining</th>
                    <th>Progress</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var progress in savingsGoalProgress)
                {
                    <tr>
                        <td>@progress.Goal.Name</td>
                        <td>@FormatPeso(progress.Goal.TargetAmount)</td>
                        <td>@FormatPeso(progress.Goal.CurrentSavedAmount)</td>
                        <td>@FormatPeso(progress.Remaining)</td>
                        <td>@FormatPercentage(progress.PercentageProgress)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    private static readonly CultureInfo PhilippineCulture = CultureInfo.GetCultureInfo("en-PH");

    private List<AccountBalance> accountBalances = [];
    private List<Transaction> recentTransactions = [];
    private List<BudgetProgress> budgetProgress = [];
    private List<SavingsGoalProgress> savingsGoalProgress = [];
    private decimal totalBalance;
    private decimal currentMonthIncome;
    private decimal currentMonthExpenses;
    private decimal amountSavedThisMonth;
    private decimal totalRemainingBudget;
    private string currentMonthName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var userId = await GetCurrentUserId();

        if (userId is null)
            return;

        var today = DateOnly.FromDateTime(DateTime.Today);
        var monthStart = new DateOnly(today.Year, today.Month, 1);
        var nextMonthStart = monthStart.AddMonths(1);
        currentMonthName = monthStart.ToString("MMMM yyyy", PhilippineCulture);

        await LoadAccountBalances(userId);
        await LoadMonthlyTransactions(userId, monthStart, nextMonthStart);
        await LoadRecentTransactions(userId);
        await LoadBudgetProgress(userId, today, monthStart, nextMonthStart);
        await LoadSavingsGoals(userId);
    }

    private async Task LoadAccountBalances(string userId)
    {
        var accounts = await Db.FinancialAccounts
            .AsNoTracking()
            .Where(account => account.UserId == userId && !account.IsArchived)
            .OrderBy(account => account.Name)
            .ToListAsync();

        var accountIds = accounts.Select(account => account.Id).ToList();
        var transactions = await Db.Transactions
            .AsNoTracking()
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                accountIds.Contains(transaction.AccountId))
            .Select(transaction => new
            {
                transaction.AccountId,
                transaction.Type,
                transaction.Amount
            })
            .ToListAsync();

        accountBalances = accounts
            .Select(account =>
            {
                var income = transactions
                    .Where(transaction =>
                        transaction.AccountId == account.Id &&
                        transaction.Type == TransactionType.Income)
                    .Sum(transaction => transaction.Amount);
                var expenses = transactions
                    .Where(transaction =>
                        transaction.AccountId == account.Id &&
                        transaction.Type == TransactionType.Expense)
                    .Sum(transaction => transaction.Amount);

                return new AccountBalance(
                    account,
                    FinancialCalculations.AccountBalance(
                        account.StartingBalance,
                        income,
                        expenses));
            })
            .ToList();

        totalBalance = accountBalances.Sum(account => account.CurrentBalance);
    }

    private async Task LoadMonthlyTransactions(
        string userId,
        DateOnly monthStart,
        DateOnly nextMonthStart)
    {
        var monthlyTransactions = await Db.Transactions
            .AsNoTracking()
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                transaction.Date >= monthStart &&
                transaction.Date < nextMonthStart &&
                (transaction.Type == TransactionType.Income ||
                 transaction.Type == TransactionType.Expense))
            .Select(transaction => new
            {
                transaction.Type,
                transaction.Amount
            })
            .ToListAsync();

        currentMonthIncome = monthlyTransactions
            .Where(transaction => transaction.Type == TransactionType.Income)
            .Sum(transaction => transaction.Amount);
        currentMonthExpenses = monthlyTransactions
            .Where(transaction => transaction.Type == TransactionType.Expense)
            .Sum(transaction => transaction.Amount);
        amountSavedThisMonth = FinancialCalculations.AmountSaved(
            currentMonthIncome,
            currentMonthExpenses);
    }

    private async Task LoadRecentTransactions(string userId)
    {
        recentTransactions = await Db.Transactions
            .AsNoTracking()
            .Include(transaction => transaction.Category)
            .Include(transaction => transaction.FinancialAccount)
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                (transaction.Type == TransactionType.Income ||
                 transaction.Type == TransactionType.Expense))
            .OrderByDescending(transaction => transaction.Date)
            .ThenByDescending(transaction => transaction.Id)
            .Take(5)
            .ToListAsync();
    }

    private async Task LoadBudgetProgress(
        string userId,
        DateOnly today,
        DateOnly monthStart,
        DateOnly nextMonthStart)
    {
        var budgets = await Db.Budgets
            .AsNoTracking()
            .Include(budget => budget.Category)
            .Where(budget =>
                budget.UserId == userId &&
                budget.Month == today.Month &&
                budget.Year == today.Year)
            .OrderBy(budget => budget.Category.Name)
            .ToListAsync();

        if (budgets.Count == 0)
        {
            budgetProgress = [];
            totalRemainingBudget = 0;
            return;
        }

        var categoryIds = budgets
            .Select(budget => budget.CategoryId)
            .ToList();
        var expenses = await Db.Transactions
            .AsNoTracking()
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                transaction.Type == TransactionType.Expense &&
                categoryIds.Contains(transaction.CategoryId) &&
                transaction.Date >= monthStart &&
                transaction.Date < nextMonthStart)
            .Select(transaction => new
            {
                transaction.CategoryId,
                transaction.Amount
            })
            .ToListAsync();

        var spendingByCategory = expenses
            .GroupBy(transaction => transaction.CategoryId)
            .ToDictionary(
                group => group.Key,
                group => group.Sum(transaction => transaction.Amount));

        budgetProgress = budgets
            .Select(budget =>
            {
                spendingByCategory.TryGetValue(budget.CategoryId, out var amountSpent);
                return new BudgetProgress(budget, amountSpent);
            })
            .ToList();

        totalRemainingBudget = budgetProgress.Sum(progress => progress.Remaining);
    }

    private async Task LoadSavingsGoals(string userId)
    {
        var goals = await Db.SavingsGoals
            .AsNoTracking()
            .Where(goal => goal.UserId == userId)
            .OrderByDescending(goal => goal.Id)
            .ToListAsync();

        savingsGoalProgress = goals
            .Select(goal => new SavingsGoalProgress(goal))
            .ToList();
    }

    private async Task<string?> GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private static string FormatPeso(decimal amount)
    {
        var formattedAmount = decimal.Abs(amount).ToString("N2", PhilippineCulture);

        return amount < 0
            ? $"-₱{formattedAmount}"
            : $"₱{formattedAmount}";
    }

    private static string FormatPercentage(decimal percentage) =>
        $"{percentage.ToString("0.##", PhilippineCulture)}%";

    private sealed record AccountBalance(
        FinancialAccount Account,
        decimal CurrentBalance);

    private sealed record BudgetProgress(Budget Budget, decimal AmountSpent)
    {
        public decimal Remaining =>
            FinancialCalculations.BudgetRemaining(Budget.LimitAmount, AmountSpent);

        public decimal PercentageUsed =>
            FinancialCalculations.BudgetPercentageUsed(Budget.LimitAmount, AmountSpent);

        public bool IsOverBudget =>
            FinancialCalculations.IsOverBudget(Budget.LimitAmount, AmountSpent);
    }

    private sealed record SavingsGoalProgress(SavingsGoal Goal)
    {
        public decimal Remaining =>
            FinancialCalculations.SavingsGoalRemaining(
                Goal.TargetAmount,
                Goal.CurrentSavedAmount);

        public decimal PercentageProgress =>
            FinancialCalculations.SavingsGoalPercentage(
                Goal.TargetAmount,
                Goal.CurrentSavedAmount);
    }
}
