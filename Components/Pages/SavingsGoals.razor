@page "/savings-goals"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-page">
<header class="page-header">
    <div>
        <h1>Savings Goals</h1>
        <p class="page-subtitle">Turn the things you want into clear, trackable targets.</p>
    </div>
</header>

<EditForm Model="goalInput" OnValidSubmit="SaveGoal" FormName="AddSavingsGoal" class="surface-card form-card">
    <h2 class="section-heading">Create a savings goal</h2>
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <p class="status-message status-error" role="alert">@saveError</p>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="status-message status-success" role="status">@successMessage</p>
    }

    <div class="form-grid">
    <div class="form-field form-field-full">
        <label for="goal-name">Goal Name</label>
        <InputText id="goal-name" @bind-Value="goalInput.Name" />
        <ValidationMessage For="@(() => goalInput.Name)" />
    </div>

    <div class="form-field">
        <label for="goal-target">Target Amount</label>
        <InputNumber id="goal-target" @bind-Value="goalInput.TargetAmount" step="0.01" />
        <ValidationMessage For="@(() => goalInput.TargetAmount)" />
    </div>

    <div class="form-field">
        <label for="goal-saved">Current Saved Amount</label>
        <InputNumber id="goal-saved" @bind-Value="goalInput.CurrentSavedAmount" step="0.01" />
        <ValidationMessage For="@(() => goalInput.CurrentSavedAmount)" />
    </div>

    <div class="form-field form-field-full">
        <label for="goal-date">Target Date (optional)</label>
        <InputDate id="goal-date" @bind-Value="goalInput.TargetDate" />
        <ValidationMessage For="@(() => goalInput.TargetDate)" />
    </div>

    </div>
    <div class="form-actions">
        <button type="submit" class="app-button app-button-primary">Add Savings Goal</button>
    </div>
</EditForm>

<section class="content-section">
<div class="section-bar"><h2>Your savings goals</h2></div>

@if (goalProgress.Count == 0)
{
    <div class="empty-state">No savings goals yet. Create something worth saving for.</div>
}
else
{
    <div class="card-grid">
        @foreach (var progress in goalProgress)
        {
            <article class="surface-card detail-card">
                <div class="detail-card-header">
                    <div>
                        <h3>@progress.Goal.Name</h3>
                        <p class="detail-meta">Target date: @FormatTargetDate(progress.Goal.TargetDate)</p>
                    </div>
                    <span class="badge-soft @(progress.PercentageProgress >= 100 ? "badge-success" : "badge-neutral")">@FormatPercentage(progress.PercentageProgress)</span>
                </div>
                <p class="detail-amount money-value">@FormatPeso(progress.Goal.CurrentSavedAmount)</p>
                <p class="detail-meta">saved of @FormatPeso(progress.Goal.TargetAmount)</p>
                <div class="progress-copy">
                    <span class="muted-text">Remaining</span>
                    <strong class="@(progress.Remaining < 0 ? "money-negative" : "")">@FormatPeso(progress.Remaining)</strong>
                </div>
                <div class="progress-track" aria-hidden="true">
                    <div class="progress-fill" style="width: @Math.Clamp(progress.PercentageProgress, 0, 100)%"></div>
                </div>
            </article>
        }
    </div>
}
</section>
</div>

@code {
    private SavingsGoalInput goalInput = new();
    private List<SavingsGoalProgress> goalProgress = [];
    private string? saveError;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadGoals();
    }

    private async Task SaveGoal()
    {
        saveError = null;
        successMessage = null;

        var userId = await GetCurrentUserId();

        if (userId is null)
        {
            saveError = "You must be logged in to add a savings goal.";
            return;
        }

        var goal = new SavingsGoal
        {
            UserId = userId,
            Name = goalInput.Name,
            TargetAmount = goalInput.TargetAmount!.Value,
            CurrentSavedAmount = goalInput.CurrentSavedAmount!.Value,
            TargetDate = goalInput.TargetDate
        };

        Db.SavingsGoals.Add(goal);
        await Db.SaveChangesAsync();

        goalInput = new SavingsGoalInput();
        successMessage = "Savings goal added.";

        await LoadGoals(userId);
    }

    private async Task LoadGoals()
    {
        var userId = await GetCurrentUserId();

        if (userId is null)
            return;

        await LoadGoals(userId);
    }

    private async Task LoadGoals(string userId)
    {
        var goals = await Db.SavingsGoals
            .AsNoTracking()
            .Where(goal => goal.UserId == userId)
            .OrderByDescending(goal => goal.Id)
            .ToListAsync();

        goalProgress = goals
            .Select(goal => new SavingsGoalProgress(goal))
            .ToList();
    }

    private async Task<string?> GetCurrentUserId()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    }

    private static string FormatPeso(decimal amount)
    {
        var formattedAmount = decimal.Abs(amount)
            .ToString("N2", CultureInfo.GetCultureInfo("en-PH"));

        return amount < 0
            ? $"-₱{formattedAmount}"
            : $"₱{formattedAmount}";
    }

    private static string FormatPercentage(decimal percentage) =>
        $"{percentage.ToString("0.#", CultureInfo.GetCultureInfo("en-PH"))}%";

    private static string FormatTargetDate(DateOnly? targetDate) =>
        targetDate?.ToString("MMMM d, yyyy", CultureInfo.GetCultureInfo("en-PH")) ?? "—";

    private sealed record SavingsGoalProgress(SavingsGoal Goal)
    {
        public decimal Remaining =>
            FinancialCalculations.SavingsGoalRemaining(
                Goal.TargetAmount,
                Goal.CurrentSavedAmount);

        public decimal PercentageProgress =>
            FinancialCalculations.SavingsGoalPercentage(
                Goal.TargetAmount,
                Goal.CurrentSavedAmount);
    }

    private sealed class SavingsGoalInput : IValidatableObject
    {
        [Required(ErrorMessage = "Goal name is required.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Target amount is required.")]
        [Range(typeof(decimal), "0.01", "999999999999.99", ErrorMessage = "Target amount must be greater than zero.")]
        public decimal? TargetAmount { get; set; }

        [Required(ErrorMessage = "Current saved amount is required.")]
        [Range(typeof(decimal), "0", "999999999999.99", ErrorMessage = "Current saved amount cannot be negative.")]
        public decimal? CurrentSavedAmount { get; set; }

        public DateOnly? TargetDate { get; set; }

        public IEnumerable<ValidationResult> Validate(ValidationContext validationContext)
        {
            if (!string.IsNullOrEmpty(Name) && string.IsNullOrWhiteSpace(Name))
            {
                yield return new ValidationResult(
                    "Goal name is required.",
                    [nameof(Name)]);
            }

            if (TargetAmount is not null &&
                decimal.Round(TargetAmount.Value, 2) != TargetAmount.Value)
            {
                yield return new ValidationResult(
                    "Target amount cannot have more than two decimal places.",
                    [nameof(TargetAmount)]);
            }

            if (CurrentSavedAmount is not null &&
                decimal.Round(CurrentSavedAmount.Value, 2) != CurrentSavedAmount.Value)
            {
                yield return new ValidationResult(
                    "Current saved amount cannot have more than two decimal places.",
                    [nameof(CurrentSavedAmount)]);
            }
        }
    }
}
