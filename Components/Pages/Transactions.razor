@page "/transactions"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using Kwenta.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="app-page">
<header class="page-header">
    <div>
        <h1>Transactions</h1>
        <p class="page-subtitle">A complete record of your income and expenses, newest first.</p>
    </div>
    <div class="inline-actions">
        <a class="app-button app-button-secondary" href="/income/add">Add Income</a>
        <a class="app-button app-button-primary" href="/expenses/add">Add Expense</a>
    </div>
</header>

@if (transactions.Count == 0)
{
    <div class="empty-state">No transactions yet. Add income or an expense to get started.</div>
}
else
{
    <div class="surface-card data-table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Amount</th>
                <th>Type</th>
                <th>Category</th>
                <th>Account</th>
                <th>Date</th>
                <th>Merchant/Source</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in transactions)
            {
                <tr>
                    <td data-label="Amount" class="money-value @(transaction.Type == TransactionType.Income ? "money-positive" : "money-negative")">@FormatPeso(transaction.Amount)</td>
                    <td data-label="Type"><span class="badge-soft @(transaction.Type == TransactionType.Income ? "badge-income" : "badge-expense")">@transaction.Type</span></td>
                    <td data-label="Category">@transaction.Category.Name</td>
                    <td data-label="Account">@transaction.FinancialAccount.Name</td>
                    <td data-label="Date">@transaction.Date.ToString("MMM d, yyyy", CultureInfo.GetCultureInfo("en-PH"))</td>
                    <td data-label="Merchant/Source">@transaction.Merchant</td>
                    <td data-label="Description" class="muted-text">@(string.IsNullOrWhiteSpace(transaction.Description) ? "—" : transaction.Description)</td>
                    <td data-label="Actions">
                        <div class="inline-actions">
                            <a class="text-action" href="/transactions/edit/@transaction.Id">Edit</a>
                            <a class="text-action text-action-danger" href="/transactions/delete/@transaction.Id">Delete</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
</div>

@code {
    private List<Transaction> transactions = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User
            .FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (userId is null)
            return;

        transactions = await Db.Transactions
            .AsNoTracking()
            .Include(transaction => transaction.Category)
            .Include(transaction => transaction.FinancialAccount)
            .Where(transaction =>
                transaction.UserId == userId &&
                transaction.FinancialAccount.UserId == userId &&
                (transaction.Type == TransactionType.Expense ||
                 transaction.Type == TransactionType.Income))
            .OrderByDescending(transaction => transaction.Date)
            .ThenByDescending(transaction => transaction.Id)
            .ToListAsync();
    }

    private static string FormatPeso(decimal amount) =>
        $"₱{amount.ToString("N2", CultureInfo.GetCultureInfo("en-PH"))}";
}
